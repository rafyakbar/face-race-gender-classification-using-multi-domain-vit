title = {Functional Multivariable Logistic Regression With an Application to HIV Viral Suppression Prediction},
journal = {Biometrical Journal},
volume = {66},
number = {5},
pages = {e202300081},
keywords = {Functional Principal Component Analysis, Multivariate logistic regression, Prediction, HIV viral suppression},
doi = {https://doi.org/10.1002/bimj.202300081},
