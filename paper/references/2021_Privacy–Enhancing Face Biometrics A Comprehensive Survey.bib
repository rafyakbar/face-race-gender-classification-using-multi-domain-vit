  author={Meden, Blaž and Rot, Peter and Terhörst, Philipp and Damer, Naser and Kuijper, Arjan and Scheirer, Walter J. and Ross, Arun and Peer, Peter and Štruc, Vitomir},
  journal={IEEE Transactions on Information Forensics and Security}, 
  title={Privacy–Enhancing Face Biometrics: A Comprehensive Survey}, 
  year={2021},
  volume={16},
